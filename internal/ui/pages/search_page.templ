package pages

import "github.com/osamikoyo/math-angel/internal/ui/layouts"

templ SearchPage() {
    @layouts.Page("Поиск задач — Math Angel") {
        <div class="max-w-5xl mx-auto px-4 py-12">
            
            <div class="text-center mb-12">
                <h1 class="text-5xl font-bold mb-4">Поиск задач</h1>
                <p class="text-xl text-base-content/70 max-w-md mx-auto">
                    Найдите задачу по условию, ключевому слову или ответу
                </p>
            </div>

            <div class="max-w-2xl mx-auto mb-16">
                <form 
                    method="GET"
                    action="/task/search/page_index/0/page_size/12"
                    class="relative">
                    
                    <div class="flex gap-3">
                        <div class="flex-1 relative">
                            <input 
                                type="text" 
                                name="query"
                                placeholder="Введите условие задачи или ключевое слово..."
                                class="input input-bordered input-lg w-full pl-12 text-lg py-7 rounded-2xl"
                                required
                            >
                            <span class="absolute left-5 top-1/2 -translate-y-1/2 text-2xl text-base-content/40">
                                🔍
                            </span>
                        </div>
                        
                        <button 
                            type="submit"
                            class="btn btn-primary btn-lg px-10">
                            Найти
                        </button>
                    </div>
                </form>
            </div>

            <div id="search-results">
                <!-- Результаты будут подгружаться сюда после поиска -->
                <div class="text-center py-20 text-base-content/60">
                    <div class="text-6xl mb-6">🔎</div>
                    <p class="text-xl">Введите запрос и нажмите «Найти»</p>
                </div>
            </div>

        </div>
    }
}
